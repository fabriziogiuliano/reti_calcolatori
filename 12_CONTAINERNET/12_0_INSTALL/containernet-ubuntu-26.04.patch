diff --git a/mininet/util.py b/mininet/util.py
index 4d10b30..7cc2d98 100755
--- a/mininet/util.py
+++ b/mininet/util.py
@@ -3,6 +3,7 @@
 import codecs
 import os
 import re
+import signal
 import sys
 
 from fcntl import fcntl, F_GETFL, F_SETFL
@@ -549,8 +550,78 @@ def fixLimits():
     # pylint: enable=broad-except
 
 
+def StrictVersion( version ):
+    """Comparable version key; drop-in for the removed
+       distutils.version.StrictVersion (Python >= 3.12)"""
+    return tuple( int( n ) for n in re.findall( r'\d+', str( version ) ) )
+
+# cgroup v2 (unified hierarchy, e.g. Ubuntu >= 21.10, only option on 26.04):
+# CPULimitedHost cgroups are created below this parent group
+CGROUP2_ROOT = '/sys/fs/cgroup'
+CGROUP2_PARENT = CGROUP2_ROOT + '/mininet'
+
+def cgroupV2():
+    "Is the cgroup v2 unified hierarchy mounted on /sys/fs/cgroup?"
+    return os.path.exists( CGROUP2_ROOT + '/cgroup.controllers' )
+
+def cgroup2EnableControllers( path, controllers=( 'cpu', 'cpuset' ) ):
+    "Enable cgroup v2 controllers for the children of path"
+    with open( path + '/cgroup.controllers' ) as f:
+        available = f.read().split()
+    missing = [ c for c in controllers if c not in available ]
+    if missing:
+        raise Exception( 'cgroup v2 controllers not available in %s: %s'
+                         % ( path, ' '.join( missing ) ) )
+    with open( path + '/cgroup.subtree_control', 'w' ) as f:
+        f.write( ' '.join( '+' + c for c in controllers ) )
+
+def cgroup2Remove( path, kill=False ):
+    """Remove a cgroup v2 group. rmdir fails while it still contains
+       processes, so first move them to the root group (like cgroup v1
+       'cgdelete -r'), or kill them if kill=True.
+       returns True if the group no longer exists"""
+    try:
+        with open( path + '/cgroup.procs' ) as f:
+            pids = f.read().split()
+    except FileNotFoundError:
+        return True
+    for pid in pids:
+        try:
+            if kill:
+                os.kill( int( pid ), signal.SIGKILL )
+            else:
+                with open( CGROUP2_ROOT + '/cgroup.procs', 'w' ) as f:
+                    f.write( pid )
+        except ( OSError, ValueError ):
+            pass  # process already gone
+    # killed processes leave the group asynchronously: wait (max 1 s)
+    # until the kernel reports it empty
+    for _ in range( 20 ):
+        try:
+            with open( path + '/cgroup.events' ) as f:
+                if 'populated 0' in f.read():
+                    break
+        except OSError:
+            break
+        sleep( .05 )
+    try:
+        os.rmdir( path )
+    except FileNotFoundError:
+        pass
+    except OSError:
+        return False
+    return True
+
 def mountCgroups():
     "Make sure cgroups file system is mounted"
+    if cgroupV2():
+        # Parent group for CPULimitedHost cgroups, with cpu and cpuset
+        # controllers enabled for its children
+        cgroup2EnableControllers( CGROUP2_ROOT )
+        if not os.path.isdir( CGROUP2_PARENT ):
+            os.mkdir( CGROUP2_PARENT )
+        cgroup2EnableControllers( CGROUP2_PARENT )
+        return
     mounts = quietRun( 'grep cgroup /proc/mounts' )
     cgdir = '/sys/fs/cgroup'
     csdir = cgdir + '/cpuset'
